# Copy to .env and change the password. .env is never committed.
POSTGRES_USER=listing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=listing_ads
# Change if another Postgres already uses 5432 on this machine.
POSTGRES_PORT=5432

# Language model, as "provider:model" (any provider LangChain's init_chat_model supports).
# Needs the matching key below. Use "offline" to run without a key (rule-based stand-in).
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to 0 only for local development over plain http.
SECURE_COOKIES=0
CURRENCY=$
