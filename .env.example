# Copy to .env and change the password. .env is never committed.
POSTGRES_USER=listing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=listing_ads
# Change if another Postgres already uses 5432 on this machine.
POSTGRES_PORT=5432

# Language model, as "provider:model" (any provider LangChain's init_chat_model supports).
# Needs the matching key below. Use "offline" to run without a key (rule-based stand-in).
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# LLM_MODEL=google_genai:gemini-3.5-flash
# GOOGLE_API_KEY=   (free key from https://aistudio.google.com/apikey)

# Long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to 0 only for local development over plain http.
SECURE_COOKIES=0
CURRENCY=RM

# Public address and name, used in canonical links, sitemap.xml and structured data.
SITE_URL=http://localhost:8000
SITE_NAME=Factory
CURRENCY_CODE=MYR

# Who runs the site, shown in the privacy notice (/privacy). Required before launch.
OPERATOR_NAME=
PRIVACY_EMAIL=

# Record searches (typed text, filters, result counts) with an anonymous visitor ID; described in /privacy.
SEARCH_LOGGING=1
